# Copy this file to .env and fill in your values.
# Used by docker compose (docker-compose.yml / docker-compose.prod.yml).

# Spotify Developer app credentials (https://developer.spotify.com/dashboard)
# The redirect URI must be registered under your app's settings.
# Dev: http://localhost:5173/spotify/redirect   Prod: http://localhost:8080/spotify/redirect
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/spotify/redirect

# Where the frontend redirected to after Spotify login (default: dev URL)
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed hosts for Django (defaults: localhost,127.0.0.1,backend)
#ALLOWED_HOSTS=localhost,127.0.0.1